{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "new-mijie",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	"assets": {
		"directory": "./frontend/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "puzzle_db",
			"database_id": "d997615c-dcfa-49b8-8c78-9f511c8c4b5e",
			"migrations_dir": "migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "REALTIME_HUB",
				"class_name": "RealtimeHub"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"RealtimeHub"
			]
		}
	],
	"ratelimits": [
		{
			"name": "RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 10,
				"period": 60
			}
		}
	],
	"triggers": {
		// 每日 UTC 04:00（北京时间 12:00）清理 180 天未登录的账号
		"crons": ["0 4 * * *"]
	},
	"vars": {
		"TIMEZONE": "Asia/Shanghai",
		// 为 `true` 时启用回顾模式
		"REVIEW_MODE": "true"
	}
}
